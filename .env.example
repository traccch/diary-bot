# Токен бота от @BotFather
BOT_TOKEN=123456:AA-your-token-here

# Путь к файлу базы SQLite
DB_PATH=data/diary.db

# Часовой пояс по умолчанию для новых пользователей (и для напоминаний)
DEFAULT_TZ=Europe/Moscow

# Кто может обновлять бота командой /update. Свой id можно узнать у @userinfobot.
# Если оставить пустым, хозяином считается тот, кто первым написал боту.
OWNER_ID=

# Проверять ли раз в 6 часов, не вышла ли новая версия (1 / 0)
AUTO_UPDATE_CHECK=1

# Распознавание голосовых. Пусто — бот попросит писать текстом.
# VOICE_BINARY — путь к whisper-cli (whisper.cpp), VOICE_MODEL — к файлу модели.
# Нужен также ffmpeg в PATH. Подробности — в README.
VOICE_BINARY=
VOICE_MODEL=
VOICE_LANGUAGE=ru

# Уровень логирования: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
