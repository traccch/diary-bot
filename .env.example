# Токен бота от @BotFather
BOT_TOKEN=123456:AA-your-token-here

# Путь к файлу базы SQLite
DB_PATH=data/diary.db

# Часовой пояс по умолчанию для новых пользователей (и для напоминаний)
DEFAULT_TZ=Europe/Moscow

# Кто может обновлять бота командой /update. Свой id можно узнать у @userinfobot.
# Если оставить пустым, хозяином считается тот, кто первым написал боту.
OWNER_ID=

# Проверять ли раз в 6 часов, не вышла ли новая версия (1 / 0)
# AUTO_UPDATE_CHECK=1

# Распознавание голосовых. Пусто — бот попросит писать текстом.
# VOICE_BINARY — путь к whisper-cli (whisper.cpp), VOICE_MODEL — к файлу модели.
# Нужен также ffmpeg в PATH. Подробности — в README.
VOICE_BINARY=
VOICE_MODEL=
VOICE_LANGUAGE=ru

# Уровень логирования: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# Сколько секунд держать открытым запрос обновлений к Telegram. Через
# фильтрующие сети длинный запрос обрывают на полуслове — короткий устойчивее.
POLLING_TIMEOUT=15

# Цвета в консоли выключаются так (пусто — цвет включён, если терминал его понимает)
# NO_COLOR=1

# Ходить к Telegram через прокси. Помогает, когда провайдер рвёт соединение.
# Это адрес локального прокси, а не ключ VPN: включи в своём VPN-приложении
# (Happ, v2rayN, Nekoray, sing-box) режим локального прокси и впиши то, что
# оно покажет — обычно socks5://127.0.0.1:2080.
# TELEGRAM_PROXY=auto            ← найти локальный прокси самому
# TELEGRAM_PROXY=socks5://127.0.0.1:2080

# Кому можно писать боту, через запятую. Пусто — только хозяину: тому, кто
# указан в OWNER_ID, а если он не указан — тому, кто написал боту первым.
# Свой id и id тех, кого надо добавить, видно в логе при попытке написать.
# ALLOWED_USERS=123456789, 987654321

# Что делать с новой версией:
#   install — поставить самому (по умолчанию): бот прогонит тесты и откатится,
#             если они не сойдутся, поэтому нажимать кнопку было формальностью
#   notify  — прислать сообщение с кнопкой и ждать решения
#   off     — не смотреть вовсе
# AUTO_UPDATE=install
# Как часто смотреть, не вышло ли обновление (минуты, по умолчанию 5)
# AUTO_UPDATE_MINUTES=5
