# Токен бота от @BotFather
BOT_TOKEN=123456:AA-your-token-here

# Путь к файлу базы SQLite
DB_PATH=data/pressure.db

# Часовой пояс по умолчанию для новых пользователей (и для напоминаний)
DEFAULT_TZ=Europe/Moscow

# Уровень логирования: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# Бесплатный ключ Gemini: https://aistudio.google.com/apikey (нужен только
# аккаунт Google, карта не нужна). Без ключа бот работает, но без голосового
# ввода, разбора сложных фраз и /insight.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT=20
